# Copy to .env and fill in to enable the /api/v1/ailo/ai/* endpoints
# (translation, hashtag suggestions, moderation suggestions, semantic
# search/filters) and the /api/v1/ailo/safety/urls/check endpoint. All of
# these can also be configured after the fact through Ailo's provider-key UI
# instead — a key saved there is stored in provider-credentials.json and
# takes priority over the matching var below; these are the "set once,
# ambient" alternative. Loaded at startup via `dotenv`. With no key
# configured for a provider (here or through the UI), its AI routes answer
# 503 with which provider is missing instead of attempting a call.

# At least one of these two enables the AI routes. Both can be set — Ailo's
# provider picker lets the client choose per call; the first configured one
# (openai, then gemini) is the default when it doesn't.
# https://platform.openai.com/api-keys
AP_OPENAI_API_KEY=
# https://aistudio.google.com/apikey
AP_GEMINI_API_KEY=

# Optional overrides — defaults shown.
# AP_OPENAI_MODEL=gpt-4o-mini
# AP_OPENAI_EMBED_MODEL=text-embedding-3-small
# AP_GEMINI_MODEL=gemini-2.5-flash
# AP_GEMINI_EMBED_MODEL=text-embedding-004

# Independent of the two above — enables /api/v1/ailo/safety/urls/check.
# https://developers.google.com/safe-browsing/v4/get-started
AP_SAFE_BROWSING_API_KEY=

# Independent GIF search key for /api/v1/ailo/gifs/*.
# https://klipy.com/developers
AP_KLIPY_API_KEY=

# Translation-only providers. DeepL Free keys ending in :fx automatically use
# api-free.deepl.com. LibreTranslate keys are optional for self-hosted servers.
AP_DEEPL_API_KEY=
AP_LIBRETRANSLATE_API_KEY=
# AP_LIBRETRANSLATE_URL=https://libretranslate.com
