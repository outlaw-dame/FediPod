# Copy to .env and fill in to enable the /api/v1/ailo/ai/* endpoints
# (translation, hashtag suggestions, moderation suggestions, and the
# opt-in OpenAI backend for semantic filters). Loaded at startup via
# `dotenv`. With no key set, isAiEnabled() is false and every AI route
# answers 503 instead of attempting a call.

# Required. https://platform.openai.com/api-keys
AP_OPENAI_API_KEY=

# Optional overrides — defaults shown.
# AP_OPENAI_MODEL=gpt-4o-mini
# AP_OPENAI_EMBED_MODEL=text-embedding-3-small
